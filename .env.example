# Parser workflow
# safe | normal | fast | long
PARSER_PROFILE=normal

# DeepSeek
DEEPSEEK_API_KEY=put_your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Telegram bot
TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DEFAULT_LIMIT=10
TELEGRAM_DEFAULT_CITY=Волгоград

# Optional email sending. Draft generation works without these values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=put_smtp_password_here
MAIL_FROM=user@example.com
MAIL_REPLY_TO=user@example.com
MAIL_SIGNATURE=С уважением, ваше имя
MAIL_UNSUBSCRIBE_TEXT=Если предложение неактуально, просто ответьте "не интересно", и я больше не буду писать.
